{
  "name": "@cloud-code/monorepo",
  "version": "0.2.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/fix-node-pty-perms.mjs",
    "build": "pnpm -r run build",
    "build:packages": "pnpm -r --filter './packages/*' run build",
    "dev:cli": "pnpm -C apps/cloud-code run dev",
    "dev:cli:marketplace": "CLOUD_CODE_DEV_MARKETPLACE_URL=https://code.kimi.com/kimi-code/plugins/marketplace.json pnpm -C apps/cloud-code run dev",
    "build:plugin-marketplace": "pnpm -C apps/cloud-code run build:plugin-marketplace",
    "vis": "pnpm -C apps/vis run dev",
    "typecheck": "pnpm run build:packages && pnpm -r --filter './packages/*' run typecheck && pnpm --filter @cloud-teahouse/cloudcode-cli run typecheck && pnpm --filter @cloud-code/vis-server run typecheck && pnpm --filter @cloud-code/vis-web run typecheck",
    "lint": "oxlint --type-aware",
    "lint:fix": "pnpm run lint --fix",
    "lint:pkg": "pnpm --filter @cloud-teahouse/cloudcode-cli exec publint && npm_config_cache=$PWD/.npm-cache pnpm --filter @cloud-teahouse/cloudcode-cli exec attw --pack . --profile node16",
    "sherif": "sherif",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "clean": "pnpm -r run clean"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.2",
    "@microsoft/api-extractor": "7.58.7",
    "@types/node": "^22.15.3",
    "@vitest/coverage-v8": "4.1.4",
    "oxlint": "1.59.0",
    "oxlint-tsgolint": "0.20.0",
    "publint": "0.3.18",
    "sherif": "1.11.1",
    "tsdown": "0.22.0",
    "tsx": "^4.21.0",
    "typescript": "6.0.2",
    "vitest": "4.1.4"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "packageManager": "pnpm@10.33.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msw",
      "node-pty",
      "protobufjs",
      "ssh2",
      "tree-sitter-bash"
    ]
  }
}
