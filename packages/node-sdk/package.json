{
  "name": "@cloud-code/sdk",
  "version": "0.2.1",
  "private": true,
  "description": "TypeScript SDK for the Cloud Code CLI Agent",
  "license": "MIT",
  "author": "Moonshot AI",
  "homepage": "https://github.com/yspbwx2010/cloud-code/tree/dev/packages/node-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yspbwx2010/cloud-code.git",
    "directory": "packages/node-sdk"
  },
  "bugs": {
    "url": "https://github.com/yspbwx2010/cloud-code/issues"
  },
  "keywords": [
    "kimi",
    "sdk",
    "typescript",
    "agent",
    "api"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "imports": {
    "#/*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.mts",
        "import": "./dist/index.mjs",
        "default": "./dist/index.mjs"
      }
    },
    "provenance": true
  },
  "scripts": {
    "build": "tsdown && pnpm run build:dts",
    "build:dts": "node scripts/build-dts.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .tmp-api-extractor"
  },
  "dependencies": {
    "@antfu/utils": "^9.3.0",
    "smol-toml": "^1.6.1",
    "tree-sitter-bash": "~0.25.1",
    "web-tree-sitter": "~0.25.10",
    "ws": "8.20.0",
    "yazl": "^3.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@cloud-code/agent-core": "workspace:^",
    "@cloud-code/kaos": "workspace:^",
    "@cloud-code/kosong": "workspace:^",
    "@cloud-code/oauth": "workspace:^",
    "@cloud-code/protocol": "workspace:^",
    "@types/ws": "^8.18.1",
    "@types/yazl": "^2.4.6",
    "jimp": "^1.6.1"
  }
}
